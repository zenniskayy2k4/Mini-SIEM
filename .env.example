# Ollama Cloud AI analyst (optional; rules/ML still work when disabled).
AI_PROVIDER=ollama_cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gemma4:cloud

# SQLite is primary; JSON remains a migration/fallback mirror.
SQLITE_READ_ENABLED=true
JSON_READ_FALLBACK_ENABLED=true
JSON_DUAL_WRITE_ENABLED=true

# Safe response workflow. Simulation never changes the host.
RESPONSE_MODE=simulation
RESPONSE_TARGET_OS=linux
RESPONSE_APPROVAL_TIMEOUT_SECONDS=900
RESPONSE_PROTECTED_TARGETS=localhost,127.0.0.1,::1,host.docker.internal,root,administrator,1,/,/etc,/usr,/bin,/sbin

# Optional generic or Discord webhook for high-risk incidents.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_FORMAT=generic
NOTIFICATION_TIMEOUT_SECONDS=3
NOTIFICATION_MAX_ATTEMPTS=2

# GeoIP context uses the keyless HTTPS endpoint only for public/global IPs.
GEOIP_ENABLED=true
GEOIP_ENDPOINT=https://ipwho.is
GEOIP_CACHE_TTL_SECONDS=86400
GEOIP_RATE_LIMIT_PER_SECOND=1
GEOIP_TIMEOUT_SECONDS=3
GEOIP_MAX_ATTEMPTS=2

# Normalized Windows/Sysmon ingest.
WINDOWS_EVENT_FILE=/app/data/windows_events.jsonl
WINDOWS_COLLECTOR_SECRET=

# Dashboard session security. Leave the secret empty to persist a random key in data/.
DASHBOARD_SESSION_SECRET=
DASHBOARD_COOKIE_SECURE=false

# Offline maintenance (python -m tools.maintenance).
ALERT_RETENTION_DAYS=90
LOG_ROTATE_MAX_BYTES=10485760
LOG_ROTATE_BACKUPS=5
