ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Hoặc dùng Ollama local (free, offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Chọn provider: "anthropic" | "openai" | "ollama"
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-haiku-20241022

# Bật/tắt AI enrichment
AI_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_MIN_SEVERITY=HIGH

# SQLite is the primary read path; keep JSON fallback/dual-write during migration.
SQLITE_READ_ENABLED=true
JSON_READ_FALLBACK_ENABLED=true
JSON_DUAL_WRITE_ENABLED=true

# Safe response contract. M6.1 proposes/audits actions but never executes them.
RESPONSE_MODE=simulation
RESPONSE_TARGET_OS=linux
