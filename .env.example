ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Hoặc dùng Ollama local (free, offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Chọn provider: "anthropic" | "openai" | "ollama"
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-haiku-20241022

# Bật/tắt AI enrichment
AI_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_MIN_SEVERITY=HIGH

# SQLite is the primary read path; keep JSON fallback/dual-write during migration.
SQLITE_READ_ENABLED=true
JSON_READ_FALLBACK_ENABLED=true
JSON_DUAL_WRITE_ENABLED=true

# Safe response contract. M6.1 proposes/audits actions but never executes them.
RESPONSE_MODE=simulation
RESPONSE_TARGET_OS=linux
RESPONSE_APPROVAL_TIMEOUT_SECONDS=900
# Add gateway IPs and critical assets that response actions must never target.
RESPONSE_PROTECTED_TARGETS=localhost,127.0.0.1,::1,host.docker.internal,root,administrator,1,/,/etc,/usr,/bin,/sbin

# Optional generic/Discord webhook for HIGH, CRITICAL or human-review alerts.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_FORMAT=generic
NOTIFICATION_TIMEOUT_SECONDS=3
NOTIFICATION_MAX_ATTEMPTS=2
